@using Microsoft.AspNetCore.Identity
@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blog_Website</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Blog_Website.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
    integrity="sha512-KwuF9Q9hY2GxGV9rk0o6nQbkDGREnYmtM4qGciC2r9J8w8W1F3ThY3YnglGv0myeS8K/Np9nAZ8L6mGZPR3U9g==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Blog_Website</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                @* هيخش علي اللي مسجل دخول  *@
                                <a class="nav-link" asp-controller="Profile" asp-action="Profile" asp-route-userId="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value">
                                    <i class="bi bi-person-circle"></i> Profile
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="GetAll">
                                    <i class="bi bi-person-circle"></i> Explore
                                </a>
                            </li>

                            <li class="nav-item mx-2">
                                <a class="nav-link text-primary" href="/Post/Add" title="Add Post">
                                    Add Post <i class="fa fa-plus-square fa-lg"></i>
                                </a>
                            </li>

                            <li class="nav-item mx-2">
                                <a class="nav-link" href="/Message/Index">
                                    Message <i class="fa fa-paper-plane fa-lg"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                @await Component.InvokeAsync("Notification")

                <form id="logoutForm">
                    @Html.AntiForgeryToken()
                    <button id="logoutBtn" type="button" class="btn btn-danger">Logout</button>
                </form>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/microsoft-signalr/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("ReceiveNotification", function (title, redirectUrl) {
            // ✅ زود العدد
            let badge = document.querySelector("#notification-badge");
            if (badge) {
                let count = parseInt(badge.innerText || "0");
                badge.innerText = count + 1;
            }

            // ✅ أضف الإشعار الجديد للقائمة
            let list = document.querySelector("#notification-list");
            if (list) {
                let li = document.createElement("li");
                li.innerHTML = `<a class="dropdown-item unread" href="${redirectUrl}">${title}</a>`;
                list.prepend(li);
            }
        });

        connection.start()
            .then(() => console.log("✅ SignalR connected"))
            .catch(err => console.error("❌ Connection error:", err));
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    
</body>
</html>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
