@using System.Security.Claims
@using Blog_Website.Helpers
@model Blog_Website.Models.Entities.Comment

<div class="comment mb-3 border-bottom pb-2" id="comment-@Model.Id">
    <div class="d-flex align-items-start">
        <!-- User Image -->
        <div class="me-2">
            @if (!string.IsNullOrEmpty(Model.ApplicationUser?.ImageURL))
            {
                <img src="@Model.ApplicationUser.ImageURL"
                     alt="User Image"
                     class="rounded-circle"
                     style="width:40px; height:40px; object-fit:cover;" />
            }
            else
            {
                <i class="fa-regular fa-user fa-2x text-secondary"></i>
            }
        </div>

        <!-- Comment Content -->
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-center">
                <a href="/Profile/Profile?userId=@Model.UserId"
                   class="fw-semibold text-decoration-none text-dark">
                    @(Model.ApplicationUser?.UserName ?? "Unknown User")
                </a>
                <small class="text-muted">@TimeFormatter.ToInstagramStyle(Model.CreatedDate)</small>

            </div>

            <p class="mb-1">@Model.Content</p>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="Comment Image"
                     class="mt-2 rounded"
                     style="max-width:100%; height:auto; border:1px solid #ddd;" />
            }
        </div>
    </div>
</div>
