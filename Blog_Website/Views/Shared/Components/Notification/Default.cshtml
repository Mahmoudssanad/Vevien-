@model List<Blog_Website.Models.Entities.Notification>

@{
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="dropdown">
    <a class="nav-link position-relative" href="#!" role="button" data-bs-toggle="dropdown">
        <i class="fas fa-bell fs-5"></i>
        <span id="notification-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            @(unreadCount > 0 ? unreadCount : 0)
        </span>
    </a>

    <ul class="dropdown-menu dropdown-menu-end" id="notification-list">
        @foreach (var notification in Model)
        {
            <li>
                <a class="dropdown-item @(notification.IsRead ? "" : "unread")"
                   href="/Notification/Read/@notification.Id">
                    @notification.Title
                </a>
            </li>
        }

        <!-- زر تحميل المزيد -->
        <li>
            <button class="dropdown-item text-center text-primary" id="load-more-btn">
                Load more
            </button>
        </li>
    </ul>
</div>

<style>
    .dropdown-item.unread {
        background-color: #e7f3ff;
        font-weight: 600;
        border-left: 4px solid #1877f2;
    }

    .dropdown-item {
        background-color: white;
        font-weight: normal;
    }
</style>


<script>
    let currentPage = 1;

    document.getElementById("load-more-btn").addEventListener("click", function () {
        currentPage++;
        fetch(`/Notification/Load?page=${currentPage}`)
            .then(res => res.text())
            .then(html => {
                const parser = new DOMParser();
                const newItems = parser.parseFromString(html, 'text/html').querySelectorAll('#notification-list li:not(:last-child)');
                newItems.forEach(item => document.querySelector('#notification-list').insertBefore(item, document.getElementById("load-more-btn").parentElement));
            })
            .catch(err => console.error(err));
    });
</script>
