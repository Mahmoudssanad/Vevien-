@using System.Security.Claims
@using Blog_Website.Helpers
@model IEnumerable<Post>

@{
    ViewData["Title"] = "Public Feed";
}

<div class="container mt-4" style="max-width: 650px;">
    @if (Model != null && Model.Any())
    {
        foreach (var post in Model)
        {
            <div class="card mb-4 shadow-sm border-0">
                <!-- Header: user info -->
                <div class="card-header bg-white border-0 d-flex align-items-center">
                    <a href="/Profile/Profile?userId=@post.UserId">
                        <img src="@(string.IsNullOrEmpty(post.ApplicationUser?.ImageURL)
                            ? Url.Content("~/images/profile/default.png")
                            : Url.Content(post.ApplicationUser.ImageURL))"
                             class="rounded-circle me-2"
                             style="width: 40px; height: 40px; object-fit: cover;" />

                    </a>

                    <div>
                        <strong>@post.ApplicationUser?.UserName</strong><br />
                        <small class="text-muted">@TimeFormatter.ToInstagramStyle(post.CreatedDate)</small>
                    </div>
                    @if (post.UserId == User.FindFirst(ClaimTypes.NameIdentifier).Value)
                    {
                        <div class="dropdown">
                            <button class="btn btn-light border-0" data-bs-toggle="dropdown">
                                :::
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="@Url.Action("Edit", "Post", new { postId = post.Id })">Edit</a></li>
                                <li><a class="dropdown-item text-danger" href="@Url.Action("Delete", "Post", new { postId = post.Id })">Delete</a></li>
                            </ul>
                        </div>
                    }

                </div>

                <!-- Post Image -->
                @if (!string.IsNullOrEmpty(post.ImageUrl))
                {
                    <a asp-action="Details" asp-controller="Post" asp-route-postId="@post.Id">
                        <img src="@post.ImageUrl"
                             class="img-fluid"
                             alt="Post image"
                             style="width:100%; max-height:600px; object-fit:cover;" />
                    </a>
                }

                <!-- Post body -->
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(post.Content))
                    {
                        @* <a asp-action ="Details" asp-controller="Post" asp-route-postId="@post.Id"> *@
                        <p class="card-text">@post.Content</p>
                        @* </a> *@
                    }

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            <button class="btn btn-light btn-sm me-2">
                                Like<i class="fa-regular fa-heart"></i>
                            </button>
                            <button class="btn btn-light btn-sm">
                                Comment<i class="fa-regular fa-comment"></i>
                            </button>
                        </div>

                        @* <a href="/Profile/Profile?userId=@post.UserId" *@
                        @*    class="text-decoration-none small text-primary"> *@
                        @*     View Profile *@
                        @* </a> *@
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center text-muted mt-5">
            <i class="fa fa-camera fa-3x mb-3"></i>
            <p>No public posts available yet.</p>
        </div>
    }
</div>
