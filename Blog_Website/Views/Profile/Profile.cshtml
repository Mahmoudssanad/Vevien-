@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<style>
    .profile-header {
    background: linear-gradient(135deg, #4c6ef5, #15aabf);
    border-radius: 20px;
    padding: 2rem;
    color: white;
    }

    .profile-img {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid #fff;
    box-shadow: 0px 4px 10px rgba(0,0,0,0.15);
    }

    .stats-box {
    border-radius: 15px;
    padding: 1.2rem;
    background: #fff;
    box-shadow: 0 3px 8px rgba(0,0,0,0.06);
    transition: 0.2s ease;
    }

    .stats-box:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 14px rgba(0,0,0,0.1);
    }

    .gallery img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
    transition: 0.2s ease;
    box-shadow: 0px 3px 8px rgba(0,0,0,0.08);
    }

    .gallery img:hover {
    transform: scale(1.03);
    }
</style>

<div class="container py-5">

    <!-- Header -->
    <div class="profile-header text-center mb-5">
        <div class="d-flex justify-content-center mb-3">

            <!-- Profile Image -->
            <img src="@(string.IsNullOrEmpty(Model.Image)
                                ? Url.Content("~/images/profile/default.png")
                                : Url.Content(Model.Image))"
            class="profile-img" alt="@Model.UserName">
        </div>

        <h2 class="fw-bold">@Model.UserName</h2>
        <p class="mb-1">@Model.Email</p>

        @if (Model.BirthDate.HasValue)
        {
            <p class="fw-light">@Model.BirthDate.Value.ToString("dd MMM yyyy")</p>
        }

        <!-- Edit / Follow -->
        <div class="mt-3">
            @if (User.Identity!.IsAuthenticated && Model.IsOwner)
            {
                <a asp-action="Edit" asp-controller="Profile" asp-route-userId="@Model.UserId"
                class="btn btn-light px-4 fw-semibold">
                    Edit Profile
                </a>
            }
            else
            {
                <div id="follow-section" class="mt-2">
                    @if (Model.IsFollow)
                    {
                        <button id="unfollow-btn" data-user-id="@Model.UserId"
                        class="btn btn-outline-light px-4 fw-semibold">
                            Unfollow
                        </button>
                    }
                    else
                    {
                        <button id="follow-btn" data-user-id="@Model.UserId"
                        class="btn btn-dark px-4 fw-semibold">
                            Follow
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Stats -->
    <div class="row text-center mb-5">
        <div class="col-4">
            <a asp-action="MyPosts" asp-controller="Post" asp-route-userId="@Model.UserId"
               class="text-decoration-none text-dark">
                <div class="stats-box">
                    <h4 class="fw-bold mb-0">@Model.PostsCount</h4>
                    <small class="text-muted">Posts</small>
                </div>
            </a>
        </div>

        <div class="col-4">
            <a asp-action="GetFollowing" asp-controller="Follow" asp-route-userId="@Model.UserId"
               class="text-decoration-none text-dark">
                <div class="stats-box">
                    <h4 class="fw-bold mb-0">@Model.CountFollowing</h4>
                    <small class="text-muted">Following</small>
                </div>
            </a>
        </div>

        <div class="col-4">
            <a asp-action="GetFollowers" asp-controller="Follow" asp-route-userId="@Model.UserId"
               class="text-decoration-none text-dark">
                <div class="stats-box">
                    <h4 class="fw-bold mb-0">@Model.CountFollowers</h4>
                    <small class="text-muted">Followers</small>
                </div>
            </a>
        </div>
    </div>

    <!-- Delete Account -->
    @if (User.Identity!.IsAuthenticated && Model.IsOwner)
    {
        <div class="text-center mb-4">
            <form id="deleteForm">
                @Html.AntiForgeryToken()
                <button id="deleteBtn" type="button" class="btn btn-danger px-4 fw-semibold">
                    Delete Account
                </button>
            </form>
        </div>
    }

    <!-- Gallery -->
    <h3 class="fw-bold mb-4 text-center">Posts</h3>

    <div class="gallery row g-3 justify-content-center">

        @foreach (var post in Model.Posts)
        {
            if (Model.IsOwner || post.Visible)
            {
                if (!string.IsNullOrEmpty(post.ImageUrl))
                {
                    <div class="col-4 col-md-3">
                        <a asp-action="Details" asp-controller="Post" asp-route-postId="@post.Id">
                            <img src="@post.ImageUrl" class="img-fluid">
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <div class="card shadow-sm border-0 rounded-4">
                            <div class="card-body">
                                <p>@post.Content</p>
                                <a asp-action="Details" asp-controller="Post" asp-route-postId="@post.Id"
                                   class="text-decoration-none small text-primary">
                                    View Post →
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {

            // Follow
            $(document).on('click', '#follow-btn', function () {
                const targetUserId = $(this).data('user-id');

                $.post('/Follow/AddFollow', { targetUserId })
                    .done(() => {
                        $('#follow-section').html(`
                            <button id="unfollow-btn" data-user-id="${targetUserId}"
                                    class="btn btn-outline-light px-4 fw-semibold">
                                Unfollow
                            </button>
                        `);
                    });
            });

            // Unfollow
            $(document).on('click', '#unfollow-btn', function () {
                const targetUserId = $(this).data('user-id');

                $.post('/Follow/DeleteFollow', { targetUserId })
                    .done(() => {
                        $('#follow-section').html(`
                            <button id="follow-btn" data-user-id="${targetUserId}"
                                    class="btn btn-dark px-4 fw-semibold">
                                Follow
                            </button>
                        `);
                    });
            });

        });
    </script>
}
