@model ProfileViewModel

@{
    ViewData["Title"] = "Show Profile"; 
}



<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <!-- Profile Image -->
                        @if(Model.Image != null)
                        {
                            <img src="@Model.Image"
                            alt="@Model.UserName"
                            class="rounded-circle me-4"
                            style="width: 120px; height: 120px; object-fit: cover;">
                        }
                        else
                        {
                            <img src="~/images/profile/default.png"
                            alt="@Model.UserName"
                            class="rounded-circle me-4"
                            style="width: 120px; height: 120px; object-fit: cover;">
                        }

                        <!-- User Info -->
                        <div>
                            <h4 class="fw-bold mb-2">@Model.UserName</h4>
                            <p class="text-muted mb-1">@Model.Email</p>

                            @if (Model.BirthDate.HasValue)
                            {
                                <p class="text-muted">@Model.BirthDate.Value.ToString("dd MMM yyyy")</p>
                            }


                            @if (User.Identity.IsAuthenticated && Model.IsOwner)
                            {
                                <a asp-action="Edit" asp-controller="Profile" asp-route-userId="@Model.UserId"
                                class="btn btn-outline-primary btn-sm">Edit profile </a>
                            }
                            else
                            {
                                <div id="follow-section" class="text-center mt-3">
                                    @if (Model.IsFollow)
                                    {
                                        <button id="unfollow-btn"
                                        data-user-id="@Model.UserId"
                                        class="btn btn-outline-danger px-4">
                                            Unfollow
                                        </button>
                                    }
                                    else
                                    {
                                        <button id="follow-btn"
                                        data-user-id="@Model.UserId"
                                        class="btn btn-primary px-4">
                                            Follow
                                        </button>
                                    }
                                </div>
                            }

                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Stats -->
                    <div class="d-flex justify-content-around text-center mb-4">
                        <a asp-action="MyPosts" asp-controller="Post" asp-route-userId="@Model.UserId"
                           class="fw-semibold text-decoration-none text-dark">
                            <div>
                                <h6 class="fw-bold mb-0">@Model.PostsCount</h6>
                                <small class="text-muted">Posts</small>
                            </div>
                        </a>


                        <a asp-action="GetFollowing" asp-controller="Follow" asp-route-userId="@Model.UserId"
                           class="fw-semibold text-decoration-none text-dark">
                            <div>
                                <h6 class="fw-bold mb-0">@Model.CountFollowing</h6>
                                <small class="text-muted">Following</small>
                            </div>
                        </a>
                        <a asp-action="GetFollowers" asp-controller="Follow" asp-route-userId="@Model.UserId"
                           class="fw-semibold text-decoration-none text-dark">
                            <div>
                                <h6 class="fw-bold mb-0">@Model.CountFollowers</h6>
                                <small class="text-muted">Followers</small>
                            </div>
                        </a>

                    </div>

                    <!-- Gallery -->
                    <div class="container my-5">
                        <div class="d-flex flex-column align-items-center">
                            <!-- هنا ممكن تحط بيانات البروفايل لو عندك -->
                            @* <h3 class="fw-bold mb-4">@Model.ProfileName</h3> *@

                            <!-- الجاليري -->
                            <div class="row g-3 justify-content-center" style="max-width: 900px;">
                                @foreach (var post in Model.Posts)
                                {
                                    if (Model.IsOwner || post.Visible)
                                    {
                                        if (!string.IsNullOrEmpty(post.ImageUrl))
                                        {
                                            <!-- Post with Image -->
                                            <div class="col-4">
                                                <a asp-action="Details" asp-controller="Post" asp-route-postId="@post.Id">
                                                    <img src="@post.ImageUrl"
                                                         class="img-fluid rounded"
                                                         style="object-fit: cover; aspect-ratio: 1 / 1;" />
                                                </a>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- Text-only Post -->
                                            <div class="col-12">
                                                <div class="card shadow-sm border-0 rounded-3">
                                                    <div class="card-body">
                                                        <p class="mb-2">@post.Content</p>
                                                        <div class="text-muted small d-flex justify-content-between">
                                                            <a asp-action="Details" asp-controller="Post" asp-route-postId="@post.Id">View Post</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </div>



                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Follow
            $(document).on('click', '#follow-btn', function () {
                const targetUserId = $(this).data('user-id');

                $.ajax({
                    url: '/Follow/AddFollow',
                    type: 'POST',
                    data: { targetUserId: targetUserId },
                    success: function () {
                        $('#follow-section').html(`
                            <button id="unfollow-btn" data-user-id="${targetUserId}" class="btn btn-outline-danger px-4">
                                Unfollow
                            </button>
                        `);
                    },
                    error: function () {
                        alert('Something went wrong while trying to follow user.');
                    }
                });
            });

            // Unfollow
            $(document).on('click', '#unfollow-btn', function () {
                const targetUserId = $(this).data('user-id');

                $.ajax({
                    url: '/Follow/DeleteFollow',
                    type: 'POST',
                    data: { targetUserId: targetUserId },
                    success: function () {
                        $('#follow-section').html(`
                            <button id="follow-btn" data-user-id="${targetUserId}" class="btn btn-primary px-4">
                                Follow
                            </button>
                        `);
                    },
                    error: function () {
                        alert('Something went wrong while trying to unfollow user.');
                    }
                });
            });

        });
    </script>
}
