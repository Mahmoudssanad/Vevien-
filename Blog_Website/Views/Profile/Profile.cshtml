@model ProfileViewModel

@{
    ViewData["Title"] = "Show Profile"; 
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <!-- Profile Image -->
                        @if(Model.Image != null)
                        {
                            <img src="@Model.Image"
                            alt="@Model.UserName"
                            class="rounded-circle me-4"
                            style="width: 120px; height: 120px; object-fit: cover;">
                        }
                        else
                        {
                            <img src="~/images/profile/default.png"
                            alt="@Model.UserName"
                            class="rounded-circle me-4"
                            style="width: 120px; height: 120px; object-fit: cover;">
                        }

                        <!-- User Info -->
                        <div>
                            <h4 class="fw-bold mb-2">@Model.UserName</h4>
                            <p class="text-muted mb-1">@Model.Email</p>
                            @if (Model.BirthDate.HasValue)
                            {
                                <p class="text-muted">@Model.BirthDate.Value.ToString("dd MMM yyyy")</p>
                            }
                            @if (User.Identity.IsAuthenticated && Model.IsOwner)
                            {
                                <a asp-action="Edit" asp-controller="Profile" asp-route-userId="@Model.UserId"
                                   class="btn btn-outline-primary btn-sm">Edit profile </a>
                            }
                            
                            @* <button class="btn btn-outline-secondary btn-sm">Message</button> *@
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Stats -->
                    <div class="d-flex justify-content-around text-center mb-4">
                        <div>
                            <h6 class="fw-bold mb-0">45</h6>
                            <small class="text-muted">Posts</small>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">230</h6>
                            <small class="text-muted">Followers</small>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">180</h6>
                            <small class="text-muted">Following</small>
                        </div>
                    </div>

                    <!-- Gallery -->
                    @* <div class="row g-2"> *@
                    @*     @for (int i = 1; i <= 9; i++) *@
                    @*     { *@
                    @*         <div class="col-4"> *@
                    @*             <img src="/images/sample@(i).jpg" *@
                    @*                  class="img-fluid rounded" *@
                    @*                  style="object-fit: cover; aspect-ratio: 1 / 1;"> *@
                    @*         </div> *@
                    @*     } *@
                    @* </div> *@
                </div>
            </div>
        </div>
    </div>
</div>
