@model ForgetPasswordViewModel;

@{
    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Blog_System.styles.css" asp-append-version="true" />

<style>
    body {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #f5f6fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .auth-card {
        width: 420px;
        border-radius: 12px;
        padding: 30px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.1);
    }

    .auth-title {
        font-size: 26px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 12px;
        color: #333;
    }

    .auth-subtitle {
        text-align: center;
        font-size: 14px;
        color: #555;
        margin-bottom: 25px;
    }

    .btn-custom {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 8px;
    }
</style>

<div class="auth-card">

    <h2 class="auth-title">Reset Password</h2>
    <p class="auth-subtitle">Enter your email and we'll send you an OTP code.</p>

    <div asp-validation-summary="All" class="text-danger text-center mb-3"></div>

    <form asp-action="ForgetPassword" method="post">

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold"></label>
            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-custom">
            Send OTP
        </button>
    </form>
</div>
