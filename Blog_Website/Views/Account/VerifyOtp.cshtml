@model OtpViewModel

@{
    ViewData["Title"] = "Verify Email";
    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Blog_System.styles.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">Email Verification</h4>
                </div>
                <div class="card-body p-4">

                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-info text-center">
                            @TempData["Message"]
                        </div>
                    }

                    <form asp-action="VerifyOtp" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <input type="hidden" asp-for="Email"/>
                        <input type="hidden" asp-for="Flow"/>


                        <div class="form-group mb-3">
                            <label asp-for="Otp" class="form-label">Enter OTP Code</label>
                            <input asp-for="Otp" class="form-control" placeholder="Enter the 6-digit code" />
                            <span asp-validation-for="Otp" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Verify</button>

                        <div class="mt-3 text-center">
                            <p class="text-muted">
                                Didn’t get the code?
                                <a asp-action="ResendOtp" asp-route-email="@Model.Email" asp-route-flow="@Model.Flow">Resend OTP</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


