@model Post
@using Blog_Website.Helpers
@using System.Security.Claims


@{
    ViewData["Title"] = "Post Details";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
integrity="sha512-KwuF9Q9hY2GxGV9rk0o6nQbkDGREnYmtM4qGciC2r9J8w8W1F3ThY3YnglGv0myeS8K/Np9nAZ8L6mGZPR3U9g==" crossorigin="anonymous" referrerpolicy="no-referrer" />

@* like modal to show user who liked the post *@
<div class="modal fade" id="likesModal" tabindex="-1" aria-labelledby="likesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="likesModalLabel">Liked by</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="likesList" class="list-group">
                    <!-- Users will be injected here -->
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="container py-5 d-flex justify-content-center">
    <div class="card shadow-sm border-0 rounded-4" style="max-width: 600px; width: 100%;">

        <!-- 🔹 Header -->
        <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <img src="@(string.IsNullOrEmpty(Model.ApplicationUser?.ImageURL)
                    ? Url.Content("~/images/profile/default.png")
                    : Url.Content(Model.ApplicationUser.ImageURL))"
                     class="rounded-circle me-2"
                     style="width: 40px; height: 40px; object-fit: cover;" />

                <div>
                    <h6 class="fw-bold mb-0">@Model.ApplicationUser?.UserName</h6>
                    <small class="text-muted">@TimeFormatter.ToInstagramStyle(Model.CreatedDate)</small>
                </div>
            </div>
            @if (Model.UserId == User.FindFirst(ClaimTypes.NameIdentifier).Value)
            {
                <div class="dropdown">
                    <button class="btn btn-light border-0" data-bs-toggle="dropdown">
                        
                        <i class="bi bi-three-dots"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="@Url.Action("Edit", "Post", new { postId = Model.Id })">Edit</a></li>
                        <li><a class="dropdown-item text-danger" href="@Url.Action("Delete", "Post", new { postId = Model.Id })">Delete</a></li>
                    </ul>
                </div>
            }
        </div>

        <!-- 🔹 Post Image -->
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="Post Image"
                 class="img-fluid"
                 style="width: 100%; object-fit: cover; max-height: 500px;">
        }

        <!-- 🔹 Post Content -->
        <div class="card-body pb-0">
            @if (!string.IsNullOrEmpty(Model.Content))
            {
                <p class="mb-3">@Model.Content</p>
            }
        </div>

        <!-- زر لفتح المودال -->
        <button class="btn btn-link p-0 open-likes-modal"
                data-post-id="@Model.Id"
                data-bs-toggle="modal"
                data-bs-target="#likesModal">
            @Model.TempLikesCount Likes
        </button>

        <!-- 🔹 Post Actions -->
        <div class="card-body pt-2">
            <div class="d-flex align-items-center mb-2">

                <button class="btn btn-light btn-sm me-3 like-btn"
                        data-target-id="@Model.Id"
                        data-target-type="Post">
                    @if (Model.TempLikesCount > 0)
                    {
                        <i class="@(Model.IsLikedByCurrentUser
                                ? "fa-solid fa-heart text-danger"
                                : "fa-regular fa-heart")"></i>
                    }
                    else
                    {
                        <i class="fa-regular fa-heart"></i>
                    }
                    <span class="like-text">Like</span>
                    <span class="like-count">@Model.TempLikesCount</span>
                </button>
            </div>
        </div>


        <hr class="my-1">

        <!-- 🔹 Comments Section -->
        <div class="card-body pt-2">
            <h6 class="fw-bold mb-3">Comments</h6>

            @if (Model.Comments != null && Model.Comments.Any())
            {
                @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedDate))
                {
                    <div class="d-flex mb-3">
                        <img src="@(comment.ApplicationUser?.ImageURL ?? "/images/default-profile.png")"
                             class="rounded-circle me-2"
                             style="width: 35px; height: 35px; object-fit: cover;">
                        <div class="bg-light rounded-4 px-3 py-2" style="flex: 1;">
                            <strong>@comment.ApplicationUser?.UserName</strong>
                            <p class="mb-1">@comment.Content</p>
                            <small class="text-muted">@comment.CreatedDate.ToString("MMM dd, yyyy • hh:mm tt")</small>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted small">No comments yet.</p>
            }

            <!-- 🔹 Add Comment -->
            <form asp-action="AddComment" asp-controller="Post" asp-route-postId="@Model.Id" method="post" class="mt-3">
                <div class="input-group">
                    <input type="text" name="commentText" class="form-control rounded-start-pill" placeholder="Add a comment..." required>
                    <button type="submit" class="btn btn-primary rounded-end-pill">Post</button>
                </div>
            </form>
        </div>

        <!-- 🔹 Footer -->
        <div class="card-footer bg-white border-0 text-center">
            <a href="/Home/Index" class="btn btn-outline-secondary rounded-pill px-4">Back</a>
            
        </div>
    </div>
</div>



@section Scripts {
    <script>
        $(document).ready(function () {
            $(document).on("click", ".like-btn", function (e) {
                e.preventDefault();

                const button = $(this);
                const targetId = button.data("target-id");
                const targetType = button.data("target-type");

                $.ajax({
                    type: "POST",
                    url: "/Like/Toggle",
                    data: {
                        TargetId: targetId,
                        TargetType: targetType
                    },
                    success: function (response) {
                        if (response.success) {
                            console.log("✅ AJAX Response:", response);

                            const icon = button.find("i");
                            const count = button.find(".like-count");

                            // تغيير الأيقونة حسب الحالة
                            if (response.liked) {
                                icon.removeClass("fa-regular").addClass("fa-solid text-danger");
                            } else {
                                icon.removeClass("fa-solid text-danger").addClass("fa-regular");
                            }

                            // تحديث العدد
                            count.text(response.count);
                        } else {
                            console.warn("⚠️ Server returned success=false");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("❌ AJAX Error:", error);
                    }
                });
            });
        });
    </script>

    <script>
        $(document).ready(function () {

            // لما المستخدم يضغط على زر "X Likes"
            $(document).on("click", ".open-likes-modal", function () {

                const postId = $(this).data("post-id");
                const likesList = $("#likesList");

                // نفضي المودال قبل ما نحمّل الداتا الجديدة
                likesList.empty();

                $.ajax({
                    type: "GET",
                    url: `/Like/GetPostLikes?postId=${postId}`,
                    success: function (users) {
                        if (users.length === 0) {
                            likesList.append(`<li class="list-group-item text-muted">No likes yet.</li>`);
                            return;
                        }

                        // نضيف كل المستخدمين جوه الليست
                               users.forEach(user => {
                            const profilePic = user.imageURL
                                ? `<img src="${user.imageURL}" class="rounded-circle me-2" width="35" height="35">`
                                : `<i class="fa-regular fa-user me-2 fa-lg"></i>`;

                            likesList.append(`
                                <li class="list-group-item d-flex align-items-center">
                                    <a href="/Profile/Profile?userId=${user.id}"
                                       class="text-decoration-none text-dark d-flex align-items-center w-100">
                                        ${profilePic}
                                        <span>${user.userName}</span>
                                    </a>
                                </li>
                            `);
                        });

                    },
                    error: function (xhr, status, error) {
                        likesList.append(`<li class="list-group-item text-danger">Error loading likes.</li>`);
                        console.error("❌ AJAX Error:", error);
                    }
                });
            });

        });
    </script>

}

