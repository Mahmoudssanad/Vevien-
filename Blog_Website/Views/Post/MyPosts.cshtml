@using System.Security.Claims
@model List<Blog_Website.ViewModel.Post.PostViewModel>

@{
    ViewData["Title"] = "My Posts";
}

@* like modal to show user who liked the post *@
<div class="modal fade" id="likesModal" tabindex="-1" aria-labelledby="likesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="likesModalLabel">Liked by</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="likesList" class="list-group">
                    <!-- Users will be injected here -->
                </ul>
            </div>
        </div>
    </div>
</div>


<div class="container mt-4">
    <h3 class="mb-4">My Posts</h3>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            You haven’t posted anything yet.
        </div>
    }
    else
    {
        foreach (var post in Model)
        {
            <div class="card mb-4 shadow-sm">
                @if(post.UserId == User.FindFirst(ClaimTypes.NameIdentifier).Value)
                {
                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <img src="@post.ImageUrl"
                        alt="Post image"
                        class="card-img-top rounded-top"
                        style="object-fit: cover; width: 100%; height: 300px;" />
                    }

                    <!-- زر لفتح المودال -->
                    <button class="btn btn-link p-0 open-likes-modal"
                    data-post-id="@post.Id"
                    data-bs-toggle="modal"
                    data-bs-target="#likesModal">
                        @post.TempLikesCount Likes
                    </button>

                    <div class="card-body">
                        <p class="card-text">@post.Content</p>

                        <div class="d-flex align-items-center mt-3">
                            <!-- زر الإعجاب -->
                            <button class="btn btn-light btn-sm me-3 like-btn"
                            data-target-id="@post.Id"
                            data-target-type="Post">
                                @if (post.TempLikesCount > 0)
                                {
                                    <i class="@(post.IsLikedByCurrentUser
                                ? "fa-solid fa-heart text-danger"
                                : "fa-regular fa-heart")"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-heart"></i>
                                }

                                <span class="like-text">Like</span>
                                <span class="like-count">@post.TempLikesCount</span>
                            </button>

                            <!-- زر التعليق (مستقبلاً AJAX Comments) -->
                            <button class="btn btn-light btn-sm comment-btn">
                                <i class="fa-regular fa-comment"></i>
                                <span>Comment</span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    @if (post.Visible)
                    {
                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <img src="@post.ImageUrl"
                                 alt="Post image"
                                 class="card-img-top rounded-top"
                                 style="object-fit: cover; width: 10%; height: 30px;" />
                        }

                        <!-- زر لفتح المودال -->
                        <button class="btn btn-link p-0 open-likes-modal"
                                data-post-id="@post.Id"
                                data-bs-toggle="modal"
                                data-bs-target="#likesModal">
                            @post.TempLikesCount Likes
                        </button>

                        <div class="card-body">
                            <p class="card-text">@post.Content</p>

                            <div class="d-flex align-items-center mt-3">
                                <!-- زر الإعجاب -->
                                <button class="btn btn-light btn-sm me-3 like-btn"
                                        data-target-id="@post.Id"
                                        data-target-type="Post">
                                    @if (post.TempLikesCount > 0)
                                    {
                                        <i class="@(post.IsLikedByCurrentUser
                                ? "fa-solid fa-heart text-danger"
                                : "fa-regular fa-heart")"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-heart"></i>
                                    }

                                    <span class="like-text">Like</span>
                                    <span class="like-count">@post.TempLikesCount</span>
                                </button>

                                <!-- زر التعليق (مستقبلاً AJAX Comments) -->
                                <button class="btn btn-light btn-sm comment-btn">
                                    <i class="fa-regular fa-comment"></i>
                                    <span>Comment</span>
                                </button>
                            </div>
                        </div>
                    }
                    
                }

            </div>
        }
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/js/all.min.js" crossorigin="anonymous"></script>

    <script>
        $(document).ready(function () {
            $(document).on("click", ".like-btn", function (e) {
                e.preventDefault();

                const button = $(this);
                const targetId = button.data("target-id");
                const targetType = button.data("target-type");

                $.ajax({
                    type: "POST",
                    url: "/Like/Toggle",
                    data: {
                        TargetId: targetId,
                        TargetType: targetType
                    },
                    success: function (response) {
                        if (response.success) {
                            console.log("✅ AJAX Response:", response);

                            const icon = button.find("i");
                            const count = button.find(".like-count");

                            // تغيير الأيقونة حسب الحالة
                            if (response.liked) {
                                icon.removeClass("fa-regular").addClass("fa-solid text-danger");
                            } else {
                                icon.removeClass("fa-solid text-danger").addClass("fa-regular");
                            }

                            // تحديث العدد
                            count.text(response.count);
                        } else {
                            console.warn("⚠️ Server returned success=false");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("❌ AJAX Error:", error);
                    }
                });
            });
        });
    </script>

    <script>
        $(document).ready(function () {

            // لما المستخدم يضغط على زر "X Likes"
            $(document).on("click", ".open-likes-modal", function () {

                const postId = $(this).data("post-id");
                const likesList = $("#likesList");

                // نفضي المودال قبل ما نحمّل الداتا الجديدة
                likesList.empty();

                $.ajax({
                    type: "GET",
                    url: `/Like/GetPostLikes?postId=${postId}`,
                    success: function (users) {
                        if (users.length === 0) {
                            likesList.append(`<li class="list-group-item text-muted">No likes yet.</li>`);
                            return;
                        }

                        // نضيف كل المستخدمين جوه الليست
                               users.forEach(user => {
                            const profilePic = user.imageURL
                                ? `<img src="${user.imageURL}" class="rounded-circle me-2" width="35" height="35">`
                                : `<i class="fa-regular fa-user me-2 fa-lg"></i>`;

                            likesList.append(`
                                <li class="list-group-item d-flex align-items-center">
                                    <a href="/Profile/Profile?userId=${user.id}"
                                       class="text-decoration-none text-dark d-flex align-items-center w-100">
                                        ${profilePic}
                                        <span>${user.userName}</span>
                                    </a>
                                </li>
                            `);
                        });

                    },
                    error: function (xhr, status, error) {
                        likesList.append(`<li class="list-group-item text-danger">Error loading likes.</li>`);
                        console.error("❌ AJAX Error:", error);
                    }
                });
            });

        });
</script>
}

